# Cloud mode (Meta Model API / Muse Spark)
META_API_KEY=
LLM_MODEL=muse-spark-1.3
LLM_REASONING_EFFORT=low

# Privacy mode: run a Meta open-weights model locally, e.g. `ollama pull llama3.1:8b`
# B2R_MODE=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# Heuristics only: leave META_API_KEY empty and B2R_MODE unset
